# Copy to the repository-root .env and replace every value.
# .env is ignored and is the only local secret source.

# LLM provider credentials used by planners and allocators.
OPENAI_API_KEY=

# Bootstrap credentials for local stateful containers and agent memory access.
AGENT_FLEET_POSTGRES_PASSWORD=
AGENT_FLEET_MINIO_ROOT_PASSWORD=
AGENT_FLEET_CLICKHOUSE_PASSWORD=
AGENT_FLEET_VAULT_DEV_ROOT_TOKEN=
