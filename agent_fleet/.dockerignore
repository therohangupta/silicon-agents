# =============================================================================
# .dockerignore — patterns excluded from Docker *build contexts* under agent_fleet/.
#
# Applies when Dockerfiles use `context: .` (platform services and silicon_agent).
# Goal: smaller, faster builds; avoid leaking secrets or host junk into images.
# Lines are path patterns relative to the build context (this directory).
# =============================================================================

# Git metadata — never needed inside an image layer.
.git

# Local secrets / API keys loaded via env_file at *run* time, not bake time.
.env

# Bytecode caches from host Python runs.
*.pyc

# Python cache directories.
__pycache__

# Local virtualenvs (dependencies are installed inside the Dockerfile).
.venv

# Alternate venv directory name.
venv

# Node modules from dashboard-web; frontend is not baked via these contexts.
node_modules

# Markdown docs — not required to run services (keeps context small).
*.md

# Pytest cache from host test runs.
.pytest_cache

# Runtime bind-mount data (nats/telemetry/git/dashboard); not part of the image.
.data

# Coverage data files from host test runs.
.coverage

# HTML coverage report trees.
htmlcov

# setuptools / pip egg-info metadata from editable installs.
*.egg-info

# setuptools .eggs scratch directory.
.eggs
